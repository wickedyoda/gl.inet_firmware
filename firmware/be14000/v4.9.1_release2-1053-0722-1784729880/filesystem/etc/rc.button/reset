#!/bin/sh

. /lib/functions.sh
. /lib/functions/gl_util.sh

OVERLAY="$( grep ' /overlay ' /proc/mounts )"

case "$ACTION" in
pressed)
	[ -z "$OVERLAY" ] && return 0

	reset_btn_pressed
;;
timeout)
	. /etc/diag.sh
	set_state failsafe
;;
released)
	[ -z "$OVERLAY" ] && return 0

	reset_btn_released

	if [ "$SEEN" -ge 20 ]
	then
		return 0
	elif [ "$SEEN" -ge 8 ]
	then
		ubus -t 3 call gl-cloud notify '{"type":"hardware/reset"}' >/dev/null 2>&1
		sleep 2

		factory_reset
	elif [ "$SEEN" -ge 3 ]
	then
		reset_network &
	fi
;;
esac

return 0
