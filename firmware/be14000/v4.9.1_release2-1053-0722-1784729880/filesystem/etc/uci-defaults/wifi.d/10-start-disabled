. /lib/functions.sh

setting=

set_wifi_iface() {
    config_get device "$1" device
    config_get type "$device" type

    if [ -f /lib/wifi/rtk_wifi.sh ]; then
        return 0
    fi
    [ "$type" = "qcawificfg80211" -o "$type" = "mac80211" ] || return 0

    config_get mode "$1" mode
    [ "$mode" = "ap" ] || return 0

    config_get disabled "$1" disabled 0
    config_get start_disabled "$1" start_disabled
    config_get mld "$1" mld
    config_get iot "$1" iot
    config_get guest "$1" guest
    # 暂时废弃该字段 所以全部start_disabled字段都删除
    if [ "$mode" = "ap" ]; then
        if [ -n "$start_disabled" ]; then
            setting="$setting
delete wireless.$1.start_disabled"
        fi
        return 0
    fi
    [ -z "$start_disabled" ] || return 0

    setting="$setting
set wireless.$1.disabled=0
set wireless.$1.start_disabled=$disabled"
}

config_load wireless
config_foreach set_wifi_iface wifi-iface

setting="$setting
commit wireless"

echo "$setting" | uci batch
