uci_apply_wifi_defaults() {
    [ -d /etc/uci-defaults/wifi.d ] || return 0

    cd /etc/uci-defaults/wifi.d

    files="$(ls)"

    [ -z "$files" ] && {
        cd -
        return 0
    }

    for file in $files; do
        ( . "./$(basename $file)" )
    done

    cd -
    uci commit
    rm -r /etc/uci-defaults/wifi.d
}

band2ifname() {
    case $1 in
    2g)
        echo "wlan0"
        ;;
    5g)
        echo "wlan1"
        ;;
    6g)
        echo "wlan2"
        ;;
    esac
}

fix_wifi_ifname_mtk() {
    local band=$1
    local mode=$2
    local ifname=$3
    local guest=$4
    local idx=0

    echo "$ifname" | grep -q ra && return
    echo "$ifname" | grep -q apcli && return

    ifname=ra

    [ "$mode" = "sta" ] && ifname=apcli

    if [ "$type" = "mtkwifi"]; then
        echo "$band" | grep -q 5 && ifname="$ifname"i
    else
        echo "$band" | grep -q 5 && ifname="$ifname"x
    fi

    [ "$guest" = "1" ] && let idx=idx+1

    echo $ifname$idx
}

fix_wifi_ifname() {
    local guest="guest2g"
    local gifname=""
    local ifname
    local guest
    local iot
    local type
    local index=1
    local multi_ap

    config_get device "$1" device
    config_get guest "$1" guest
    config_get iot "$1" iot

    config_get band "$device" band
    config_get type "$device" type
    config_get multi_ap "$1" multi_ap

    [ "$type" = "mtk" -o "$type" = "mtkwifi" ] && {
        config_get ifname "$1" ifname
        config_get mode "$1" mode
        ifname=$(fix_wifi_ifname_mtk $band $mode $ifname $guest)
        [ -n "$ifname" ] && uci set wireless.$1.ifname="$ifname"
        return
    }

    [ -e /bin/sfwifi ] && return
    [ "$guest" = "1" ] && return
    [ "$iot" = "1" ] && return
    [ "$multi_ap" = "1" ] && return

    echo "$band" | grep -q 5 && guest="guest5g"

    if [ -e /lib/wifi/qcawificfg80211.sh ]; then
        config_get mode "$1" mode
        [ "$mode" != "ap" ] && return
        ifname=$(band2ifname $band)
        gifname="$ifname$index"
    elif [ -e /lib/wifi/qcacld32.sh ]; then
        config_get mode "$1" mode
        [ "$mode" != "ap" ] && return
        ifname=$(band2ifname $band)
        [ "$band" = "2g" ] && gifname="wlan3"
        [ "$band" = "5g" ] && gifname="wlan4"
        [ "$band" = "6g" ] && gifname="wlan5"
    elif [  -e /lib/wifi/rtk_wifi.sh ]; then
        ifname=$(band2ifname $band)
        gifname=$ifname-vap0
    else
        ifname=$(band2ifname $band)
        gifname=$ifname-1
    fi

    uci set wireless.$1.ifname="$ifname"
    uci set wireless.$guest.ifname="$gifname"

    mlo_support=$(cat /usr/share/wifi-features-$device | jsonfilter -e '@.mlo')
    if [ "$mlo_support" = true ]; then
        local mloiface="wlanmld$band"

        index=$((index + 1))
        mloifname="$ifname$index"
        index=$((index + 1))
        uci set wireless.$mloiface.ifname="$mloifname"
    fi
}

[ "$(uci -q get glconfig.general.inited)" = "1" ] && {
    config_load wireless
    config_foreach fix_wifi_ifname wifi-iface
    uci commit wireless
    uci_apply_wifi_defaults
    exit 0
}

