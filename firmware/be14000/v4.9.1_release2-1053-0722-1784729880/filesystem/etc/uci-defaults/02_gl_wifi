wait_radio_configured() {
    local radio="$1"
    local n=30

    [ -e /lib/wifi/qcawificfg80211.sh ] && n=100
    [ -e /lib/wifi/qcacld32.sh ] && n=100
    [ -e /lib/wifi/rtk_wifi.sh ] && n=100

    echo "WiFi: wait $radio configured..." > /dev/console

    while  [ $n -gt 0 ]
    do
        uci -q get wireless."$radio" > /dev/null && {
            echo "WiFi: wait $radio configured OK" > /dev/console
            return 0
        }

        sleep 1
        let n=n-1
    done

    echo "WiFi: wait $radio configured timeout" > /dev/console
    return 1
}

wait_configured() {
    local name radio
    local n=10

    while  [ $n -gt 0 ]
    do
        [ -d /proc/gl-hw-info ] && break
        sleep 1
        let n=n-1
    done

    for name in $(ls /usr/share/wifi-features-*); do
        radio=${name#/usr/share/wifi-features-}
        wait_radio_configured $radio || return 1
    done

    return 0
}

