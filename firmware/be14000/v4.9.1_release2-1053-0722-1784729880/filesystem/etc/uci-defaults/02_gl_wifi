            [ "$band" = "5g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 3)
            [ ! -f /proc/gl-hw-info/device_mac ] && macaddr="$(get_random_bssid)"
            guest_mac=$(guest_wifi_macaddr_add $macaddr 2)
            ;;
        BE9300)
            if [ ! -f /proc/gl-hw-info/device_mac ]; then
                macaddr="$(get_random_bssid)"
                if [ "$band" = "6g" ]; then
                    guest_mac=$(qca_6g_wifi_macaddr_add $macaddr 1)
                fi
            else
                [ "$band" = "2g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 3)
                [ "$band" = "5g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 4)
                if [ "$band" = "6g" ]; then
                    macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 5)
                    guest_mac=$(qca_6g_wifi_macaddr_add $macaddr 1)
                else
                    guest_mac=$(guest_wifi_macaddr_add $macaddr 2)
                fi
            fi
            ;;
        BE6500)
            if [ ! -f /proc/gl-hw-info/device_mac ]; then
                macaddr="$(get_random_bssid)"
            else
                [ "$band" = "2g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 3)
                [ "$band" = "5g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 4)
                guest_mac=$(guest_wifi_macaddr_add $macaddr 2)
            fi
            ;;
        esac
    fi
    if [ "$type" == "qcacld32" ]; then
        case "$model" in
        E5800)
            [ "$band" = "2g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 2)
            if [ "$band" = "5g" ]; then
                macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 3)
                acs_freq_list='5180,5200,5220,5240,5745,5765,5785,5805,5825'
            fi
            [ "$band" = "6g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 4)
            [ ! -f /proc/gl-hw-info/device_mac ] && macaddr="$(get_random_bssid)"
            guest_mac=$(guest_wifi_macaddr_add $macaddr 2)
            ;;
        esac
    fi

    if [ "$type" == "mtkwifi" ]; then
        if [ ! -f /proc/gl-hw-info/device_mac ]; then
            macaddr="$(get_random_bssid)"
        else
            case "$model" in
            BE14000)
                [ "$band" = "2g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 4)
                [ "$band" = "5g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 5)
                [ "$band" = "6g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 6)
                ;;
            *)
                [ "$band" = "2g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 2)
                [ "$band" = "5g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 3)
                [ "$band" = "6g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 4)
                ;;
            esac
        fi
        
        guest_mac=$(guest_wifi_macaddr_add $macaddr 2)
    fi

    if [  -e /lib/wifi/rtk_wifi.sh ]; then
        if [ ! -f /proc/gl-hw-info/device_mac ]; then
            macaddr="$(get_random_bssid)"
        else
            [ "$band" = "2g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 1)
            [ "$band" = "5g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 2)
        fi

        guest_mac=$(guest_wifi_macaddr_add $macaddr 1)
    fi

    if [ "$type" == "mtk" ]; then
        case "$model" in
        *)
            if [ ! -f /proc/gl-hw-info/device_mac ]; then
                macaddr="$(get_random_bssid)"
            else
                [ "$band" = "2g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 2)
                [ "$band" = "5g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 3)
            fi

            guest_mac=$(guest_wifi_macaddr_add $macaddr 2)
            ;;
        esac
    fi

    if [ "$type" == "mac80211" ]; then
        case "$model" in
        *)
            if [ ! -f /proc/gl-hw-info/device_mac ]; then
                macaddr="$(get_random_bssid)"
            else
                [ "$band" = "2g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 2)
                [ "$band" = "5g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 3)
            fi

            guest_mac=$(guest_wifi_macaddr_add $macaddr 2)
            ;;
        esac
    fi

    random_bssid="$(get_random_bssid)"
    uci -q batch <<-EOF
        set wireless.$1.macaddr="$random_bssid"
        set wireless.$1.factory_macaddr="$macaddr"
        set wireless.$1.ssid="$ssid"
        set wireless.$1.encryption="$encryption"
        set wireless.$1.sae_pwe="$sae_pwe"
        set wireless.$1.key="$key"
        set wireless.$1.wds=1
        set wireless.$1.isolate=0
        set wireless.$1.hidden=0
        set wireless.$1.ifname="$ifname"
        set wireless.$1.ieee80211k=1
        set wireless.$1.bss_transition=1
        set wireless.$1.init=1
        set wireless.$1.random_bssid=1
EOF

    if [ "$band" = "6g" ]; then
        random_guest_mac=$(qca_6g_wifi_macaddr_add $random_bssid 1)
    else
        random_guest_mac="$(get_random_bssid)"
    fi
    uci -q get network.guest > /dev/null && {
        uci -q batch <<-EOF
            set wireless.$guest=wifi-iface
            set wireless.$guest.device="$device"
            set wireless.$guest.network=guest
            set wireless.$guest.mode=ap
            set wireless.$guest.ifname="$gifname"
            set wireless.$guest.encryption="$encryption"
            set wireless.$guest.sae_pwe="$sae_pwe"
            set wireless.$guest.key=goodlife
            set wireless.$guest.ssid="$ssid-Guest"
            set wireless.$guest.macaddr="$random_guest_mac"
            set wireless.$guest.factory_macaddr="$guest_mac"
            set wireless.$guest.guest=1
            set wireless.$guest.disabled=1
            set wireless.$guest.wds=1
            set wireless.$guest.isolate=1
            set wireless.$guest.hidden=0
            set wireless.$guest.init=0
            set wireless.$guest.random_bssid=1
EOF
    }

    [ "$type" = "qcawificfg80211" ] && {
        if [ "$band" = "6g" ]; then
            uci set wireless.$1.sae=1
            uci set wireless.$guest.sae=1
            uci set wireless.$1.acs_6g_only_psc="1"
        elif [ "$band" = "5g" ]; then
            uci set wireless.$1.sae=1
            uci set wireless.$guest.sae=1
        fi

        case "$model" in
        BE6500|BE9300)
            [ "$band" = "2g" ] && {
                uci set wireless.$1.disablecoext=1
                uci set wireless.$guest.disablecoext=1
            }

            uci set wireless.$1.wpa_group_rekey=4320000
            uci set wireless.$guest.wpa_group_rekey=4320000
            ;;
        esac
    }

    if [ "$type" = "qcawificfg80211" ]; then
        [ "$band" = "5g" ] || [ "$band" = "6g" ] && {
            uci set wireless.$1.no_beacon_rsnxe=0
            uci set wireless.$guest.no_beacon_rsnxe=0
        }
        [ "$band" = "2g" ] && {
            uci set wireless.$1.no_beacon_rsnxe=1
            uci set wireless.$guest.no_beacon_rsnxe=1
        }
    fi

    [ "$type" = "qcacld32" ] && {
        if [ "$band" = "6g" ]; then
            uci set wireless.$1.sae=1
            uci set wireless.$guest.sae=1
        elif [ "$band" = "5g" ]; then
            uci set wireless.$1.sae=1
            uci set wireless.$guest.sae=1
            uci set wireless.$1.acs_freq_list=$acs_freq_list
            uci set wireless.$guest.acs_freq_list=$acs_freq_list
        fi
    }

    mlo_support=$(cat /usr/share/wifi-features-$device | jsonfilter -e '@.mlo')
    if [ "$mlo_support" != true ]; then
        return
    fi

    if [ "$type" = "mtkwifi" ]; then
        uci set wireless.$guest.vifidx=$((index+1))
        fix_mtwifi_mld_wifi_iface $device $macaddr $index
    else
        fix_mld_wifi_iface $device $macaddr $index $random_bssid
    fi
}

set_default() {
    config_load wireless
    config_foreach fix_wifi_device wifi-device
    uci commit wireless

    config_load wireless
    config_foreach fix_wifi_iface wifi-iface
    uci commit wireless

    case "$model" in
        BE5100|MT3600BE|BE14000|BE10000)
            fix_mtwifi_mld_group
            ;;
        esac
}

main() {
    touch /tmp/wait_for_wifi_config
    wait_configured && {
        set_default
        uci_apply_wifi_defaults
    }
    rm /tmp/wait_for_wifi_config

    rm /tmp/.gl-wifi-default
    /sbin/wifi reload
}

main &
