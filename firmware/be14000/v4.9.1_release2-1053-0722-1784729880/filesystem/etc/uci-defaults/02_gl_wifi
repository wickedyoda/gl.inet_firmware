fix_wifi_device() {
    local channel htmode hwmode band channels country macaddr max_txpwr txpower_drop

    json_load "$(cat /usr/share/wifi-features-$1)"
    json_get_vars band

    config_get channel "$1" channel 0
    config_get htmode "$1" htmode
    config_get hwmode "$1" hwmode
    config_get type "$1" type

    [ "$(echo $htmode | grep -o [0-9][0-9])" = "20" ] && htmode=$(echo $htmode | sed 's/20/40/')
    [ -z "$htmode" ] && {
        if [ "$type" == "qcawificfg80211" ]; then
            if [ "$band" = "2g" ]; then
                htmode=HT40
            elif [ "$band" = "6g" ]; then
                htmode=HT320
            else
                htmode=HT80
            fi
        elif [ "$type" == "qcacld32" ]; then
            if [ "$band" = "2g" ]; then
                htmode=EHT40
            elif [ "$band" = "6g" ]; then
                htmode=EHT160
            else
                htmode=EHT80
            fi
        fi
    }

    country=$(get_country_code)

    if [ "$type" == "mac80211" -o "$type" == "qcawificfg80211" -o "$type" == "qcacld32" ]; then
        [ $band = "5g" ] && {
            channels="36,40,44,48"
            [ "$country" = "US" -o "$country" = "CN" ] && channels="36,40,44,48,149,153,157,161"
        }

        [ $band = "6g" ] && {
            channels="5,21,37,53"
            [ "$country" = "US" ] && channels="5,21,37,53,69,85"
        }
    fi

    if [ "$type" == "qcawificfg80211" ]; then
        case "$model" in
        B3000)
            macaddr="$(get_random_bssid)"
            ;;
        X2000)
            macaddr="$(get_random_bssid)"
            ;;
        BE3600)
            [ "$band" = "2g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 2)
            [ "$band" = "5g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 3)
            [ ! -f /proc/gl-hw-info/device_mac ] && macaddr="$(get_random_bssid)"
            [ $band = "5g" ] && channels="36,40,44,48"
            ;;
        BE9300)
            if [ ! -f /proc/gl-hw-info/device_mac ]
            then
                macaddr="$(get_random_bssid)"
            else
                [ "$band" = "2g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 3)
                [ "$band" = "5g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 4)
                [ "$band" = "6g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 5)
            fi
            [ $band = "5g" ] && channels="36,40,44,48"
            [ "$band" = "2g" ] && {
                uci set wireless.$1.noscan=1
            }
            ;;
        BE6500)
            if [ ! -f /proc/gl-hw-info/device_mac ]
            then
                macaddr="$(get_random_bssid)"
            else
                [ "$band" = "2g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 3)
                [ "$band" = "5g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 4)
            fi
            [ $band = "5g" ] && channels="36,40,44,48"
            [ "$band" = "2g" ] && {
                uci set wireless.$1.noscan=1
            }
            ;;
        esac

        [ -n "$macaddr" ] && {
            uci set repeater.@main[0].macaddr="92${macaddr:2}"
            uci commit repeater
        }
    fi
    if [ "$type" == "qcacld32" ]; then
        case "$model" in
        E5800)
            if [ ! -f /proc/gl-hw-info/device_mac ]; then
                macaddr="$(get_random_bssid)"
            else
                [ "$band" = "2g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 2)
                [ "$band" = "5g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 3)
                [ "$band" = "6g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 4)
            fi
            ;;
        esac

        [ -n "$macaddr" ] && {
            uci set repeater.@main[0].macaddr="92${macaddr:2}"
            uci commit repeater
        }
    fi

    if [ "$type" == "mtkwifi" ]; then
        case "$model" in
        *)
            if [ "$model" = "BE14000" ] && [ "$band" = "2g" ]; then
                htmode=EHT40
                uci set wireless.$1.noscan=1
                uci set wireless.$1.ht_coex=1
            elif [ "$band" = "5g" ]; then
                htmode=EHT80
            elif [ "$band" = "6g" ]; then
                htmode=EHT320
            fi

            if [ ! -f /proc/gl-hw-info/device_mac ]; then
                macaddr="$(get_random_bssid)"
            else
                [ "$band" = "2g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 2)
                [ "$band" = "5g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 3)
                [ "$band" = "6g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 4)
            fi
        esac

        [ -n "$macaddr" ] && {
            uci set repeater.@main[0].macaddr="92${macaddr:2}"
            uci commit repeater
        }
    fi

    if [  -e /lib/wifi/rtk_wifi.sh ]; then
        if [ ! -f /proc/gl-hw-info/device_mac ]; then
                macaddr="$(get_random_bssid)"
        else
            [ "$band" = "2g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 1)
            [ "$band" = "5g" ] && macaddr=$(macaddr_add $(cat /proc/gl-hw-info/device_mac) 2)
        fi

        [ -n "$macaddr" ] && {
            uci set repeater.@main[0].macaddr="92${macaddr:2}"
            uci commit repeater
        }
    fi

    country="${country:-US}"

    max_txpwr=$(cat /usr/share/wifi-features-$1 | jsonfilter -e "@.txpwrs.$country[3]")

    [ -n "$max_txpwr" ] || {
        max_txpwr=$(cat /usr/share/wifi-features-$1 | jsonfilter -e '@.max_txpwr')
        txpower_drop=$(cat /usr/share/wifi-features-$1 | jsonfilter -e "@.txpower_drop.$country")

        [ -n "$txpower_drop" ] && let max_txpwr=max_txpwr+txpower_drop
    }

    uci -q batch <<-EOF
        set wireless.$1.country="$country"
        set wireless.$1.txpower="$max_txpwr"
        set wireless.$1.random_bssid=1
        set wireless.$1.disabled=0
        set wireless.$1.channel=auto
        set wireless.$1.band="$band"
        set wireless.$1.htmode="$htmode"
        set wireless.$1.channels="$channels"
        set wireless.$1.macaddr="$macaddr"
EOF

    [ "$band" = "2g" ] && {
        uci set wireless.$1.legacy_rates=0
    }

    [ "$band" = "6g" ] && {
        uci set wireless.$1.chan_6g_only_psc="1"
        uci set wireless.$1.require_mode="ax"
    }

    [ "$model" == "SFT1200" -a "$country" == "JP" ]  && uci set wireless.$1.txpower_lvl="0"

    [ "$band" = "2g" -a -e /sys/kernel/debug/ieee80211/phy0/mt76/dbdc ] && uci set wireless.$1.vendor_vht="1"
    mlo_support=$(cat /usr/share/wifi-features-$1 | jsonfilter -e '@.mlo')
    if [ "$mlo_support" = true ]; then
        if [ ! -f /etc/config/mlo ]; then
            touch /etc/config/mlo
            uci set mlo.global=mlo
            uci set mlo.global.random_bssid=1
        fi
        uci add_list mlo.global.support_bands=$band
    fi

    if [ "$type" == "qcacld32" ]; then
        if [ ! -f /etc/config/environment ]; then
            touch /etc/config/environment
            uci set environment.global=environment
            uci set environment.global.use_environment="indoor"
        fi
    fi
}

fix_mld_wifi_iface() {
    local device=$1
    local macaddr=$2
    local index=$3
    local random_mac_base
    local random_mac

    # All wireless vap Macs in 6g of be9300 must maintain the same first four digits
    [ "$band" = "6g" ] && [ "$type" == "qcawificfg80211" ] && random_mac_base=$4


    if [ "$type" == "qcawificfg80211" ]; then
        case "$model" in
        BE3600)
            macaddr=$(macaddr_add $macaddr 2)
            ;;
        BE9300)
            if [ "$band" = "6g" ]; then
                macaddr=$(qca_6g_wifi_macaddr_add $macaddr 4)
            else
                macaddr=$(macaddr_add $macaddr 4)
            fi
            [ "$band" = "2g" ] && {
                local mlo_ifname="wlanmld$band"
                uci set wireless.$mlo_ifname.disablecoext=1
            }
            ;;
        BE6500)
            macaddr=$(macaddr_add $macaddr 2)
            [ "$band" = "2g" ] && {
                local mlo_ifname="wlanmld$band"
                uci set wireless.$mlo_ifname.disablecoext=1
            }
            ;;
        esac
    fi

    if [ "$type" == "qcacld32" ]; then
        case "$model" in
        E5800)
            macaddr=$(macaddr_add $macaddr 2)
            ;;
        esac
    fi

    # All wireless vap Macs in 6g of be9300 must maintain the same first four digits
    if [ "$band" = "6g" ] && [ "$type" = "qcawificfg80211" ]; then
        random_mac=$(qca_6g_wifi_macaddr_add $random_mac_base 2)
    else
        random_mac="$(get_random_bssid)"
    fi

    local encryption="psk2+ccmp"
    echo "$(uci -q get mlo.global.support_bands)" | grep -q 6g && encryption="ccmp"

    local mld_ifname="wlanmld$band"
    local mlo_ssid="GL-$model-$mac-MLO"
    index=$((index + 1))
    uci -q batch <<-EOF
        set wireless.$mld_ifname=wifi-iface
        set wireless.$mld_ifname.device="$device"
        set wireless.$mld_ifname.network=lan
        set wireless.$mld_ifname.mode=ap
        set wireless.$mld_ifname.macaddr="$random_mac"
        set wireless.$mld_ifname.factory_macaddr="$macaddr"
        set wireless.$mld_ifname.ssid="$mlo_ssid"
        set wireless.$mld_ifname.encryption="$encryption"
        set wireless.$mld_ifname.sae=1
        set wireless.$mld_ifname.key="$key"
        set wireless.$mld_ifname.wds=1
        set wireless.$mld_ifname.isolate=0
        set wireless.$mld_ifname.hidden=0
        set wireless.$mld_ifname.ifname="$ifname$index"
        set wireless.$mld_ifname.ieee80211k=1
        set wireless.$mld_ifname.bss_transition=1
        set wireless.$mld_ifname.disabled=1
        set wireless.$mld_ifname.mld="mld0"
EOF
        uci set mlo.mld0=wifi-mld
        uci set mlo.mld0.disabled=1
        uci set mlo.mld0.mld_macaddr="$(get_random_bssid)"

    if [ "$band" = "6g" ]; then
        random_mac=$(qca_6g_wifi_macaddr_add $random_mac 1)
    else
        random_mac="$(get_random_bssid)"
    fi


    index=$((index + 1))

    if [ "$type" == "qcawificfg80211" ]; then
        [ "$band" = "2g" ] || [ "$band" = "5g" ] || [ "$band" = "6g" ] && {
            uci set wireless.$mld_ifname.no_beacon_rsnxe=0
        }
    fi

    uci set mlo.mld1=wifi-mld
    uci set mlo.mld1.disabled=1
    uci set mlo.mld1.mld_macaddr="$(get_random_bssid)"
    uci commit mlo
}

