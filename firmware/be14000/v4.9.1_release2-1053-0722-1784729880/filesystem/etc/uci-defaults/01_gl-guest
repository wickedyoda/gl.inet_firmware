migrate_bridge_empty_to_device() {
    local if_sec="$1"
    local type dev_name dev_sec dev_be
    type="$(uci -q get network.${if_sec}.type)"
    [ -n "$type" ] && return 0

    dev_name="$(uci -q get network.${if_sec}.device)"
    [ -n "$dev_name" ] || return 0

    dev_sec="$(
        uci -q show network \
        | grep -F ".name='$dev_name'" \
        | grep -E "^network\.@device\[[0-9]+\]\.name=" \
        | head -n1 \
        | cut -d= -f1 \
        | sed 's/\.name$//')"
    [ -n "$dev_sec" ] || return 0

    dev_be="$(uci -q get ${dev_sec}.bridge_empty)"
    [ -n "$dev_be" ] && return 0

    uci -q batch <<-EOF
        delete network.${if_sec}.bridge_empty
        set ${dev_sec}.bridge_empty='1'
        commit network
EOF
}

if [ "$(uci -q get glconfig.general.inited)" = "1" ]; then
    migrate_bridge_empty_to_device guest
    exit 0
fi

[ -f /proc/gl-hw-info/radio ] || return

MODEL=$(cat /proc/gl-hw-info/model 2>/dev/null)

uci -q batch <<-EOF
    set network.guest=interface
    set network.guest.force_link='1'
$(if [ "$MODEL" = "sft1200" ]; then
    echo "set network.guest.type='bridge'"
else
    echo "set network.guest.device='br-guest'"
    echo "add network device"
    echo "set network.@device[-1].name='br-guest'"
    echo "set network.@device[-1].type='bridge'"
    echo "set network.@device[-1].bridge_empty='1'"
fi)
    set network.guest.proto='static'
    set network.guest.ipaddr='192.168.9.1'
    set network.guest.netmask='255.255.255.0'
    set network.guest.ip6assign='60'
    set network.guest.multicast_querier='1'
    set network.guest.igmp_snooping='0'
    set network.guest.isolate='0'
    set network.guest.disabled='1'

    commit network
EOF

uci -q batch <<-EOF
    set dhcp.guest=dhcp
    set dhcp.guest.interface=guest
    set dhcp.guest.start=100
    set dhcp.guest.limit=150
    set dhcp.guest.leasetime='12h'
    set dhcp.guest.dhcpv6=disabled
    set dhcp.guest.ra=disabled
    commit dhcp
EOF

uci -q batch <<-EOF
    add firewall zone
    set firewall.@[-1].name=guest
    set firewall.@[-1].network=guest
    set firewall.@[-1].forward=REJECT
    set firewall.@[-1].output=ACCEPT
    set firewall.@[-1].input=REJECT

    add firewall forwarding
    set firewall.@[-1].src=guest
    set firewall.@[-1].dest=wan

    add firewall rule
    set firewall.@[-1].name='Allow-DHCP'
    set firewall.@[-1].src=guest
    set firewall.@[-1].target=ACCEPT
    set firewall.@[-1].proto=udp
    set firewall.@[-1].dest_port='67-68'

    add firewall rule
    set firewall.@[-1].name='Allow-DNS'
    set firewall.@[-1].src=guest
    set firewall.@[-1].target=ACCEPT
    set firewall.@[-1].proto='tcp udp'
    set firewall.@[-1].dest_port=53
    commit firewall
EOF
