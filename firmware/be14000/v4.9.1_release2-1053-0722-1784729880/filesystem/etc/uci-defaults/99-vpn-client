create_rule(){
    local index=$1
    local name=$2
    local rule_exist=$(uci -q get route_policy.@rule[$index])

    [ "$rule_exist" = "" ] && {
        uci add route_policy rule
    }

    uci set route_policy.@rule[$index].enabled="0"
    uci set route_policy.@rule[$index].name="$name"
    uci set route_policy.@rule[$index].tunnel_id=$((index+10))
    uci set route_policy.@rule[$index].killswitch="1"
}

sync_wg_config() {
    local idx=0
    local wg_config=$(uci -q get network.wgclient.config)
    local wg_disabled=$(uci -q get network.wgclient.disabled)
    [ "$wg_config" ] && {
        create_rule 0 "Primary Tunnel"
        local group_id=$(uci -q get wireguard.$wg_config.group_id)

        uci set route_policy.@rule[$idx].via_type="wireguard"
        uci set route_policy.@rule[$idx].group_id=$group_id
        uci set route_policy.@rule[$idx].peer_id=$(echo "$wg_config" | sed -E 's/peer_([0-9]+)/\1/')

        local mtu=$(uci -q get wireguard.$wg_config.mtu)
        local masq=$(uci -q get wireguard.$wg_config.masq)
        local local_access=$(uci -q get wireguard.$wg_config.local_access)
        [ "$mtu" ] && uci set route_policy.@rule[$idx].mtu=$mtu
        [ "$masq" = "0" ] && uci set route_policy.@rule[$idx].masq="0"
        [ "$local_access" = "1" ] && uci set route_policy.@rule[$idx].local_access="1"

        uci -q delete network.wgclient

        [ "$wg_disabled" = "0" ] && {
            uci set route_policy.@rule[$idx].enabled="1"

            echo "enabled"
            return
        }

        echo "configed"
        return
    }

    echo "no config"
    return
}

sync_ovpn_client() {
    local idx=0
    local ovpn_config=$(uci -q get network.ovpnclient.config)
    local ovpn_disabled=$(uci -q get network.ovpnclient.disabled)
    [ "$ovpn_config" ] && {
        [ ! $(uci -q get route_policy.@rule[$idx]) ] && create_rule 0 "Primary Tunnel"
        local mode=$(uci -q get ovpnclient.$ovpn_config.mode)
        [ "$mode" = "tap-s2s" ] && echo "no config" && return

        local group_id=$(echo $ovpn_config | sed 's/\([0-9]*\)_\([0-9]*\)/\1/')
        local client_id=$(echo $ovpn_config | sed 's/\([0-9]*\)_\([0-9]*\)/\2/')

        uci set route_policy.@rule[$idx].via_type="openvpn"
        uci set route_policy.@rule[$idx].group_id=$group_id
        uci set route_policy.@rule[$idx].client_id=$client_id
        uci -q delete route_policy.@rule[$idx].peer_id

        local mtu=$(uci -q get ovpnclient.$ovpn_config.mtu)
        local masq=$(uci -q get ovpnclient.$ovpn_config.masq)
        local local_access=$(uci -q get ovpnclient.$ovpn_config.local_access)
        [ "$mtu" ] && uci set route_policy.@rule[$idx].mtu=$mtu
        [ "$masq" = "0" ] && uci set route_policy.@rule[$idx].masq="0"
        [ "$local_access" = "1" ] && uci set route_policy.@rule[$idx].local_access="1"

        uci -q delete network.ovpnclient

        [ "$ovpn_disabled" = "0" ] && {
            uci set route_policy.@rule[$idx].enabled="1"

            echo "enabled"
            return
        }
        echo "configed"
        return
    }

    echo "no config"
    return
}

sync_single_client(){
    local res=$(sync_wg_config 0)

    local ovpn_disabled=$(uci -q get network.ovpnclient.disabled)

    [ "$res" = "enabled" ] && {
        uci -q delete network.ovpnclient
        return
    }

    [ "$res" = "configed" ] && [ "$ovpn_disabled" = "1" ] && {
        uci -q delete network.ovpnclient
        return
    }


    [ "$res" = "configed" ] && [ "$ovpn_disabled" = "" ] && {
        uci -q delete network.ovpnclient
        return
    }


    sync_ovpn_client 0
}

create_novpn_for_cascading(){
    local ovpnserver=$(uci -q get network.ovpnserver)
    local wgserver=$(uci -q get network.wgserver)

    create_rule 1 "Cascading Tunnel"
    uci set route_policy.@rule[1].enabled="1"
    uci set route_policy.@rule[1].via_type="novpn"
    uci set route_policy.@rule[1].enabled="1"

    uci set route_policy.@rule[1].from_type="interface"
    [ "$ovpnserver" ] && uci add_list route_policy.@rule[1].from="ovpnserver"
    [ "$wgserver" ] && uci add_list route_policy.@rule[1].from="wgserver"

    uci reorder route_policy.@rule[-1]=@rule[0]
}

create_usevpn_for_cascading(){
    local ovpnserver=$(uci -q get network.ovpnserver)
    local wgserver=$(uci -q get network.wgserver)

    create_rule 1 "Cascading Tunnel"

    local via_type=$(uci -q get route_policy.@rule[0].via_type)
    local group_id=$(uci -q get route_policy.@rule[0].group_id)
    local client_id=$(uci -q get route_policy.@rule[0].client_id)
    local peer_id=$(uci -q get route_policy.@rule[0].peer_id)
    local enabled=$(uci -q get route_policy.@rule[0].enabled)
    [ "$via_type" ] && uci set route_policy.@rule[1].via_type="$via_type"
    [ "$group_id" ] && uci set route_policy.@rule[1].group_id="$group_id"
    [ "$client_id" ] && uci set route_policy.@rule[1].client_id="$client_id"
    [ "$peer_id" ] && uci set route_policy.@rule[1].peer_id="$peer_id"
    [ "$enabled" ] && uci set route_policy.@rule[1].enabled="$enabled"

    uci set route_policy.@rule[1].from_type="interface"
    [ "$ovpnserver" ] && uci add_list route_policy.@rule[1].from="ovpnserver"
    [ "$wgserver" ] && uci add_list route_policy.@rule[1].from="wgserver"

    uci reorder route_policy.@rule[-1]=@rule[0]
}

handle_global_mode(){
    sync_single_client

    local cascading_enbaled=$(need_handle_vpn_cascading)

    [ "$cascading_enbaled" = "3" ] || [ "$cascading_enbaled" = "1" ] && return
    [ "$cascading_enbaled" = "0" ] && create_novpn_for_cascading
}

handle_auto_detect(){
    uci -q delete network.wgclient
    uci -q delete network.ovpnclient
}

handle_custom_route(){
    uci -q delete network.wgclient
    uci -q delete network.ovpnclient
}

handle_domain_mode(){
    sync_single_client
    translate_vpnpolicy_domain

    local cascading_enbaled=$(need_handle_vpn_cascading)

    [ "$cascading_enbaled" = "3" ] && return
    [ "$cascading_enbaled" = "1" ] && create_usevpn_for_cascading
    [ "$cascading_enbaled" = "0" ] && create_novpn_for_cascading
}

handle_mac_mode(){
    sync_single_client
    translate_vpnpolicy_mac

    local cascading_enbaled=$(need_handle_vpn_cascading)
    [ "$cascading_enbaled" = "3" ] && return
    [ "$cascading_enbaled" = "0" ] && create_novpn_for_cascading && return
    [ "$cascading_enbaled" = "1" ] && create_usevpn_for_cascading
}

handle_vlan_mode(){
    sync_single_client
    translate_vpnpolicy_vlan
}

handle_global_options(){
    local kill_switch=$(uci -q get vpnpolicy.global.kill_switch)
    local service_policy=$(uci -q get vpnpolicy.global.service_policy)

    [ "$kill_switch" = "1" ] && {
        uci set route_policy.@default[0].enabled="0"
    } || {
        [ "$(uci -q get vpnpolicy.global.wan_access)" = "1" ] && {
            for i in $(seq 0 5); do
                uci set route_policy.@rule[$i].killswitch="0"
            done
        }
    }

    if [ "$service_policy" = "0" ]; then
        #if has mutiple vpn rules, should set openvpn/wireguard rule's service_policy to 1 first
        local rule_cont=$(uci show route_policy | grep -E '@rule\[[0-9]+\]=rule' | wc -l)
        if [ "$rule_cont" -gt 1 ] ;then
            local i=0
            for i in $(seq 0 $((rule_cont-1))); do
                local via_type=$(uci -q get route_policy.@rule[$i].via_type)
                if [ "$via_type" = "openvpn" ] || [ "$via_type" = "wireguard" ] ;then
                    uci set route_policy.@rule[$i].service_policy="1"
                fi
            done
        else
            #set first rule's service_policy to 1 defaultly
            uci set route_policy.@rule[0].service_policy="1"
        fi
    fi
}

delete_mark_in_new_conntrack(){
    local rules="$(cat /etc/config/firewall | grep mark_in_new_conntrack | grep rule | awk -F " " '{print$3}' | awk -F "'" '{print$2}')"
    for rule in $rules ;do
        uci -q delete firewall.${rule}
    done
    uci commit firewall
}

modify_old_vpn_route_name() {
    sed -E 's/rt_wg([0-9]+)/rt_wgclient\1/g' -i /etc/config/network
    sed -E 's/rt_ovpn([0-9]+)/rt_ovpnclient\1/g' -i /etc/config/network
    sed -E "/^config rule 'rt_wg(client){2,}[0-9]+'/,/^$/d" -i /etc/config/network
    sed -E "/^config rule6 'rt_wg(client){2,}[0-9]+_6'/,/^$/d" -i /etc/config/network
    sed -E "/^config rule 'rt_ovpn(client){2,}[0-9]+'/,/^$/d" -i /etc/config/network
    sed -E "/^config rule6 'rt_ovpn(client){2,}[0-9]+_6'/,/^$/d" -i /etc/config/network
}

set_global_mode() {
    [ ! -f "/etc/config/vpnpolicy" ] && return
    [ "$(uci -q get route_policy.@rule[1])" != "" ] && uci set route_policy.global.mode="1" && return

    local from_type=$(uci -q get route_policy.@rule[0].from_type)
    local to_type=$(uci -q get route_policy.@rule[0].to_type)
    local default_enabled=$(uci -q get route_policy.@default[0].enabled)

    [ "$from_type" != "" ] || [ "$to_type" != "" ] || [ "$default_enabled" = "0" ] && {
        uci set route_policy.global.mode="1"
        return
    }

    uci set route_policy.global.mode="0"
}

set_firewall_include() {
    local use_fw4='0'
    which fw4 > /dev/null && use_fw4='1'
    if [ "$use_fw4" = '1' ] ;then
        uci -q delete firewall.vpnclient
    else
        [ "$(uci -q get firewall.vpnclient)" = "" ] && {
            uci set firewall.vpnclient=include
            uci set firewall.vpnclient.type=script
            uci set firewall.vpnclient.path="/usr/bin/rtp2.sh"
            uci set firewall.vpnclient.reload=0
        }
    fi
}

add_specific_option_for_vpn_ifs() {
    add_option() {
        local section="$1"
        local proto

        config_get proto "$section" proto ''
        [ "${proto}" = 'wgclient' -o "${proto}" = 'ovpnclient' ] && uci -q set network."$section".gl_vpn_instance='1'
    }
    config_load network
    config_foreach add_option 'interface'
    uci commit network 2>/dev/null
}

clean_old_killswitch_dns_rule() {
    uci -q delete firewall.lan_drop_leaked_dns
    uci -q delete firewall.lan_drop_leak_adgdns
    uci -q delete firewall.guest_drop_leaked_dns
    uci -q delete firewall.guest_drop_leak_adgdns
    uci -q delete firewall.wgserver_drop_leaked_dns
    uci -q delete firewall.ovpnserver_drop_leaked_dns
    uci -q delete firewall.wgserver_drop_leaked_adgdns
    uci -q delete firewall.ovpnserver_drop_leaked_adgdns
    uci -q delete firewall.wan_drop_leaked_dns
    uci -q delete firewall.wan_drop_leaked_adgdns
}

update_port_forward() {
    local config_section="$1"
    local src=$(uci -q get firewall."${config_section}".src)
    local dest=$(uci -q get firewall."${config_section}".dest)
    if [ "$src" = "ovpnclient" ]; then
        uci -q set firewall."${config_section}".src='ovpnclient1'
    elif [ "$src" = "wgclient" ]; then
        uci -q set firewall."${config_section}".src='wgclient1'
    fi

    if [ "$dest" = "ovpnclient" ]; then
        uci -q set firewall."${config_section}".dest='ovpnclient1'
    elif [ "$dest" = "wgclient" ]; then
        uci -q set firewall."${config_section}".dest='wgclient1'
    fi

}

set_port_forward() {
    config_load firewall
    config_foreach update_port_forward redirect
    uci commit firewall 2>/dev/null
}

PROFILE_PREFIX="/etc/openvpn/profiles/"
set_group_work_mode() {
    local group_type
    group_type=$(uci -q get "ovpnclient.$1.group_type")
    if [ "${group_type}" != "1" ] ; then
        # only add work_mode for non-business group
        local work_mode
        work_mode=$(uci -q get "ovpnclient.$1.work_mode")
        [ "$work_mode" = "legacy" ] || [ "$work_mode" = "modern" ] && return

        # get group_id and construct profile path
        local group_id=$(uci -q get "ovpnclient.$1.group_id")
        [ -z "$group_id" ] && return

        local profile_path="${PROFILE_PREFIX}${group_id}/"
        [ ! -d "$profile_path" ] && return

        # detect cipher from ovpn config files
        local cbc_cipher=$(grep -rh -i '^cipher AES-.*-CBC' "${profile_path}" 2>/dev/null | awk '{print $2}' | head -n1)
        if [ -n "$cbc_cipher" ]; then
            # CBC cipher detected, use legacy mode
            uci set "ovpnclient.$1.work_mode"='legacy'
        else
            # no CBC cipher or modern cipher, use modern mode
            uci set "ovpnclient.$1.work_mode"='modern'
        fi
    fi
}

set_imported_ovpn_legacy_mode() {
    [ ! -f "/etc/config/ovpnclient" ] && return

    config_load ovpnclient
    config_foreach set_group_work_mode groups
    uci commit ovpnclient 2>/dev/null
}

set_always_usevpn() {
    cat /etc/group|grep -q explict_vpn || echo explict_vpn:x:20000:root >>/etc/group
    if [ -z "$(uci -q get route_policy.gl_process_vpn)" ]; then
        uci batch <<EOF
set route_policy.gl_process_vpn=rule_process
set route_policy.gl_process_vpn.name='process policy'
set route_policy.gl_process_vpn.from_type='process_gid'
set route_policy.gl_process_vpn.from='20000'
set route_policy.gl_process_vpn.tunnel_id='10100'
set route_policy.gl_process_vpn.enabled='1'
set route_policy.gl_process_vpn.via='wgclient1'
EOF
    fi
}

fix_lan_domain_leak_to_vpn () {
    sed -i "s/option local '\/lan_chgd\/'/option local '\/lan\/'/g" /etc/config/dhcp
}

fix_vpn_instance_dnsmasq_domain_cb() {
    local cfg="$1"
    local user

    config_get user "$cfg" user
    [ "$user" = "dnsmasq_vpn" ] || return 0

    uci -q delete dhcp.${cfg}.domain
    uci -q set dhcp.${cfg}.domain='lan'
}

fix_vpn_instance_dnsmasq_domain() {
    config_load dhcp
    config_foreach fix_vpn_instance_dnsmasq_domain_cb dnsmasq
}

fix_op24_dnsmasq_confdir() {
    if [ -n "$(echo "$(uci -q get dhcp.@dnsmasq[0].resolvfile)" | grep resolv.conf.auto)" ]; then
        uci set dhcp.@dnsmasq[0].confdir='/tmp/dnsmasq.d'
    fi
}

v4_9_migrate_to_profiles() {
    # Migrate VPN rules from v4.8.x group_id/peer_id format to v4.9.x profiles file format
    _delete_if_empty() {
        local section="$1"
        local from to
        from=$(uci -q get route_policy."$section".from)
        to=$(uci -q get route_policy."$section".to)
        [ -z "$from" ] && [ -z "$to" ] && uci delete route_policy."$section"
    }

    _migrate_rule() {
        local section="$1"
        local via_type group_id id tunnel_id profiles_path

        # skip if already migrated
        [ -n "$(uci -q get route_policy."$section".profiles)" ] && return

        config_get via_type "$section" via_type
        config_get group_id "$section" group_id
        config_get tunnel_id "$section" tunnel_id

        case "$via_type" in
            wireguard) config_get id "$section" peer_id ;;
            openvpn)   config_get id "$section" client_id ;;
            novpn)     return ;;
            *) _delete_if_empty "$section"; return ;;
        esac

        if [ -n "$group_id" ] && [ -n "$id" ] && [ -n "$tunnel_id" ]; then
            profiles_path="/etc/vpn_profiles.d/profile${tunnel_id}"
            mkdir -p "$(dirname "$profiles_path")"
            echo "${group_id}_${id}" > "$profiles_path"
            uci set route_policy.${section}.profiles="$profiles_path"
            # force enable killswitch to prevent traffic leaks from v4.8.x failover function failures
            uci set route_policy.${section}.killswitch="1"
        else
            # via_type set but VPN credentials removed — stale rule, clean up if no traffic rules
            _delete_if_empty "$section"
        fi
    }

    config_load route_policy
    config_foreach _migrate_rule rule
    uci commit route_policy
}

cn_disable_vpn() {
    if [ "$(get_country_code)" = "CN" ]; then
        /etc/init.d/vpn-client disable
        uci -q set route_policy.global.enabled=0
        . /lib/functions/vpn_func/global_leak_drop.sh
        clean_global_killswitch_rule
    fi
}

