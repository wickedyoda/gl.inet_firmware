    fi
}

del_direct_route_priority(){
    uci -q delete network.policy_direct_rt
    uci -q delete network.policy_direct_rt6
}

delete_old_server_firewall_rule()
{
    uci -q delete firewall.wgserver2wgclient
    uci -q delete firewall.wgserver2ovpnclient
    uci -q delete firewall.ovpnserver2wgclient
    uci -q delete firewall.ovpnserver2ovpnclient
    uci -q delete firewall.wgclient2wgserver
    uci -q delete firewall.wgclient2ovpnserver
    uci -q delete firewall.ovpnclient2wgserver
    uci -q delete firewall.ovpnclient2ovpnserver
    uci -q delete firewall.vpn_server_policy
}

set_lan_to_wan_forwarding_enabled() {
    local i=$(cat /etc/config/firewall | grep -c "config forwarding")
    while [ $i -gt 0 ]; do
        let i=i-1
        src=$(uci -q get firewall.@forwarding[$i].src)
        dest=$(uci -q get firewall.@forwarding[$i].dest)
        [ -z "$src" ] && continue

        if [ "$src" = "lan" -o "$src" = "guest" ] && [ "$dest" = "wan" ]; then
            uci set firewall.@forwarding[$i].enabled='1'
            uci commit firewall
        fi
    done
}

clear_firewall(){
	#zone
	uci -q delete firewall.ovpnclient
	uci -q delete firewall.wgclient

	uci -q delete firewall.dns_vpn
	uci -q delete firewall.dns_vpn_guest

	uci -q delete firewall.guest2ovpnclient
	uci -q delete firewall.guest2wgclient
	uci -q delete firewall.lan2ovpnclient
	uci -q delete firewall.lan2wgclient

	uci -q delete firewall.ovpnclient2wan
	uci -q delete firewall.wgclient2wan

	uci -q delete firewall.vpn_client_deal_leak
}

clean_ip_rules_44
clean_block_dns_45
add_usergroup
set_wgserver_mark
del_process_mark_fw3
del_port_foward_fw3
clean_drop_explict_vpn_dest_port
set_dns
clean_old_killswitch
clean_old_process_mark
