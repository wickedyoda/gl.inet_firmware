        uci delete firewall.block_dns
    fi
}

add_usergroup(){
    cat /etc/group|grep -q nonevpn || echo nonevpn:x:65533:root >>/etc/group
    cat /etc/group|grep -q usevpn || echo usevpn:x:10000:root >>/etc/group
    cat /etc/group|grep -q explict_vpn || echo explict_vpn:x:20000:root >>/etc/group
}

set_wgserver_mark(){
    uci set wireguard_server.main_server.fwmark="$nonevpn_mark"
}

clean_drop_explict_vpn_dest_port(){
    [ -n "$(uci -q get firewall.safe_mode_mark_drop.dest_port)" ] && {
        uci -q delete firewall.safe_mode_mark_drop.dest_port
    }
}

set_dns(){
    if [ "`uci -q get adguardhome.config.enabled`" = '1' ]; then
        uci -q set dhcp.@dnsmasq[0].localuse='0'
    fi

    if [ -z "$(uci -q get gl-dns-v2.@dns[0].override_vpn)" ]; then
        uci set gl-dns-v2.@dns[0].override_vpn="1"
    fi
