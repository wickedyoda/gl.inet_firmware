#!/bin/sh

. /lib/functions.sh
. /lib/functions/gl_util.sh

nonevpn_mark=0x8000

proxy_mode=$(uci -q get vpnpolicy.route_policy.proxy_mode)
[ "$proxy_mode" = "" ] && proxy_mode="0"

del_process_mark_fw3(){
    if [ -n "$(uci -q get firewall.process_mark.name)" ]; then
        uci delete firewall.process_mark
    fi
    if [ -n "$(uci -q get firewall.process_mark_dns.name)" ]; then
        uci delete firewall.process_mark_dns
    fi
    if [ -n "$(uci -q get firewall.process_mark_stubby.name)" ]; then
        uci delete firewall.process_mark_stubby
    fi
    if [ -n "$(uci -q get firewall.process_usevpn.name)" ]; then
        uci delete firewall.process_usevpn
    fi
}

del_port_foward_fw3(){
    uci -q delete firewall.wan_in_conn_mark
    uci -q delete firewall.lan_in_conn_mark_restore
    uci -q delete firewall.out_conn_mark_restore
    uci -q delete firewall.swap_wan_in_conn_mark
}

need_handle_vpn_cascading(){
    local tunnel1_enbaled=$(uci -q get route_policy.@rule[0].enabled)
    local ovpnserver=$(uci -q get network.ovpnserver)
    local wgserver=$(uci -q get network.wgserver)

    [ "$ovpnserver" = "" ] && [ "$wgserver" = "" ] && echo "3" && return
    [ "$tunnel1_enbaled" != "1" ] &&  echo "3" && return

    local vpn_server_policy=$(uci -q get vpnpolicy.global.vpn_server_policy)
    local enabled=$([ "$vpn_server_policy" = "1" ] && echo "0" || echo "1")

    echo $enabled
}

translate_vpnpolicy_domain(){
    local url=$(uci -q get vpnpolicy.domain.url)
    local manual=$(uci -q get vpnpolicy.domain.manual)
    local domain=$(uci -q get vpnpolicy.domain.domain)
    local default_policy=$(uci -q get vpnpolicy.domain.default_policy)
    local dst_net="dst_net"$(uci -q get route_policy.@rule[0].tunnel_id)

    [ "$manual" = "0" ] && [ "$url" != "" ] && {
        uci set route_policy.@rule[0].to=$([ "$default_policy" = "0" ] && echo $dst_net || echo "!"$dst_net)
        uci set route_policy.@rule[0].to_url="$url"
        uci set route_policy.@rule[0].to_type="ipset"
        uci set route_policy.@rule[0].to_manual="$manual"
        uci set route_policy.@rule[0].to_list_external="/etc/domain_mac_list/$dst_net"

        mkdir -p /etc/domain_mac_list
        [ -f "/etc/vpnpolicy_domain/url.txt" ] && mv /etc/vpnpolicy_domain/url.txt /etc/domain_mac_list/$dst_net
        [ -f "/etc/gl_crontabs/crontabs.d/update_vpn_url" ] && echo '0 3 * * * /usr/bin/update_vpn_domain.sh' > /etc/gl_crontabs/crontabs.d/update_vpn_url
        uci -q delete vpnpolicy.domain
        return
    }

    [ "$domain" != "" ] && {
        uci set route_policy.@rule[0].to=$([ "$default_policy" = "0" ] && echo "$dst_net" || echo "!"$dst_net)
        uci set route_policy.@rule[0].to_type="ipset"
        uci set route_policy.@rule[0].to_manual="1"
        uci set route_policy.@rule[0].to_list_external="/etc/domain_mac_list/$dst_net"

        mkdir -p /etc/domain_mac_list
        uci -q get vpnpolicy.domain.domain > /etc/domain_mac_list/$dst_net
        uci -q delete vpnpolicy.domain
        return
    }
}

translate_vpnpolicy_mac(){
    local mac_list=$(uci -q get vpnpolicy.mac.mac)
    local default_policy=$(uci -q get vpnpolicy.mac.default_policy)
    local src_mac="src_mac"$(uci -q get route_policy.@rule[0].tunnel_id)

    [ "$mac_list" != "" ] && {
        uci set route_policy.@rule[0].from=$([ "$default_policy" = "0" ] && echo "$src_mac" || echo "!"$src_mac)
        uci set route_policy.@rule[0].from_type="ipset"

        for mac in ${mac_list}; do
            uci add_list route_policy.@rule[0].from_mac="$mac"
        done
    }

    uci -q delete vpnpolicy.mac
    return
}

translate_vpnpolicy_vlan(){
    local cascading_enbaled=$(need_handle_vpn_cascading)
    local ovpnserver=$(uci -q get network.ovpnserver)
    local wgserver=$(uci -q get network.wgserver)

    local private=$(uci -q get vpnpolicy.vlan.private)
    local guest=$(uci -q get vpnpolicy.vlan.guest)

    uci set route_policy.@rule[0].from_type="interface"

    [ "$private" != "1" ] && [ "$guest" != "1" ] && {
        [ "$cascading_enbaled" = "1" ] && {
            [ "$ovpnserver" ] && uci add_list route_policy.@rule[0].from="ovpnserver"
            [ "$wgserver" ] && uci add_list route_policy.@rule[0].from="wgserver"
            return
        }

        [ "$cascading_enbaled" = "3" ] || [ "$cascading_enbaled" = "0" ] && {
            uci add_list route_policy.@rule[0].from="lan"
            uci add_list route_policy.@rule[0].from="guest"
            uci set route_policy.@rule[0].enabled=$( [ "$cascading_enabled" = "0" ] && echo 1 || echo 0 )
            uci set route_policy.@rule[0].via_type="novpn"
            return
        }
    }

    [ "$private" = "1" ] && uci add_list route_policy.@rule[0].from="lan"
    [ "$guest" = "1" ] && uci add_list route_policy.@rule[0].from="guest"
    [ "$ovpnserver" ] && [ "$cascading_enbaled" = "1" ] && uci add_list route_policy.@rule[0].from="ovpnserver"
    [ "$wgserver" ] && [ "$cascading_enbaled" = "1" ] && uci add_list route_policy.@rule[0].from="wgserver"

    uci -q delete vpnpolicy.vlan
    return
}

clean_ip_rules_44(){
