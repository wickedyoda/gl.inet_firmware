#!/bin/sh
# GL.iNet VLAN subnet UCI defaults (OR0089)
# Sets up independent bridge devices and fixed subnet defaults on first boot.
# DSA model: br-lan / br-guest / br-iot (no br-lan.N bridge-vlan)

. /lib/functions.sh

_check_bridge() {
    local section="$1"
    local target="$2"
    local name
    config_get name "$section" name
    [ "$name" = "$target" ] && _bridge_found=1
}

_check_zone() {
    local section="$1"
    local target="$2"
    local name
    config_get name "$section" name
    [ "$name" = "$target" ] || return
    if [ "$target" = "guest" ]; then
        _guest_zone_found=1
    elif [ "$target" = "iot" ]; then
        _iot_zone_found=1
    fi
}

ensure_bridge() {
    local bridge_name="$1"
    _bridge_found=0
    config_load network
    config_foreach _check_bridge device "$bridge_name"

    if [ "$_bridge_found" = "0" ]; then
        uci -q batch <<-EOF
            add network device
            set network.@device[-1].name='${bridge_name}'
            set network.@device[-1].type='bridge'
EOF
    fi
}

setup_lan() {
    ensure_bridge "br-lan"
    uci -q set network.lan.device='br-lan'
    uci -q set network.lan.display_name='main'
}

setup_guest() {
    ensure_bridge "br-guest"
    local guest_exists
    guest_exists=$(uci -q get network.guest 2>/dev/null)

    if [ -z "$guest_exists" ]; then
        uci -q batch <<-EOF
            set network.guest=interface
            set network.guest.proto='static'
            set network.guest.ipaddr='192.168.9.1'
            set network.guest.netmask='255.255.255.0'
            set network.guest.disabled='1'
            set network.guest.device='br-guest'
            set network.guest.display_name='guest'
            set network.guest.vlan_id='9'

            set dhcp.guest=dhcp
            set dhcp.guest.interface='guest'
            set dhcp.guest.ignore='1'
            set dhcp.guest.start='100'
            set dhcp.guest.limit='150'
            set dhcp.guest.leasetime='12h'
EOF
    else
        uci -q set network.guest.device='br-guest'
        uci -q set network.guest.display_name='guest'
        uci -q set network.guest.vlan_id='9'
    fi
}

setup_iot() {
    uci -q set network.iot.device='br-iot'
    uci -q set network.iot.display_name='iot'
    uci -q set network.iot.vlan_id='10'
}

setup_firewall_zones() {
    _guest_zone_found=0
    config_load firewall
    config_foreach _check_zone zone "guest"
    if [ "$_guest_zone_found" = "0" ]; then
        uci -q batch <<-EOF
            add firewall zone
            set firewall.@zone[-1].name='guest'
            add_list firewall.@zone[-1].network='guest'
            set firewall.@zone[-1].input='ACCEPT'
            set firewall.@zone[-1].output='ACCEPT'
            set firewall.@zone[-1].forward='REJECT'

            add firewall forwarding
            set firewall.@forwarding[-1].src='guest'
            set firewall.@forwarding[-1].dest='wan'
            set firewall.@forwarding[-1].enabled='1'
EOF
    fi

    local guest_fwd_found=0
    for sid in $(uci -q show firewall | sed -n "s/^firewall\.\([^.]*\)\.src='guest'$/\1/p"); do
        [ "$(uci -q get firewall.${sid}.dest 2>/dev/null)" = "wan" ] || continue
        uci -q set firewall.${sid}.enabled='1'
        guest_fwd_found=1
    done
    if [ "$guest_fwd_found" = "0" ]; then
        uci -q batch <<-EOF
            add firewall forwarding
            set firewall.@forwarding[-1].src='guest'
            set firewall.@forwarding[-1].dest='wan'
            set firewall.@forwarding[-1].enabled='1'
EOF
    fi

    uci -q batch <<-EOF
        set gl-black_white_list.guest_transfer_enable='setting'
        set gl-black_white_list.guest_transfer_enable.network='guest'
        set gl-black_white_list.guest_transfer_enable.transfer_enable='1'
EOF

    _iot_zone_found=0
    if [ -n "$(uci -q get network.iot 2>/dev/null)" ]; then
        config_load firewall
        config_foreach _check_zone zone "iot"
        if [ "$_iot_zone_found" = "0" ]; then
            uci -q batch <<-EOF
                add firewall zone
                set firewall.@zone[-1].name='iot'
                add_list firewall.@zone[-1].network='iot'
                set firewall.@zone[-1].input='ACCEPT'
                set firewall.@zone[-1].output='ACCEPT'
                set firewall.@zone[-1].forward='REJECT'

                add firewall forwarding
                set firewall.@forwarding[-1].src='iot'
                set firewall.@forwarding[-1].dest='wan'
                set firewall.@forwarding[-1].enabled='1'
EOF
        fi
    fi

    local iot_fwd_found=0
    for sid in $(uci -q show firewall | sed -n "s/^firewall\.\([^.]*\)\.src='iot'$/\1/p"); do
        [ "$(uci -q get firewall.${sid}.dest 2>/dev/null)" = "wan" ] || continue
        uci -q set firewall.${sid}.enabled='1'
        iot_fwd_found=1
    done
    if [ "$iot_fwd_found" = "0" ]; then
        uci -q batch <<-EOF
            add firewall forwarding
            set firewall.@forwarding[-1].src='iot'
            set firewall.@forwarding[-1].dest='wan'
            set firewall.@forwarding[-1].enabled='1'
EOF
    fi

    uci -q batch <<-EOF
        set gl-black_white_list.iot_transfer_enable='setting'
        set gl-black_white_list.iot_transfer_enable.network='iot'
        set gl-black_white_list.iot_transfer_enable.transfer_enable='1'
EOF
}

setup_block_lan_mgmt_rules() {
	_block_one() {
		local net="$1" ip="$2"
		local r
		r=$(uci -q show firewall 2>/dev/null | grep "\.name='Block-LAN-mgmt-${net}'" | head -1 | cut -d. -f2)
		if [ -n "$r" ]; then
			uci -q set "firewall.${r}.dest_ip=${ip}"
			uci -q set "firewall.${r}.dest_port"='80 443 8080 8443'
			return 0
		fi
		uci -q batch <<-EOF
			add firewall rule
			set firewall.@rule[-1].name='Block-LAN-mgmt-${net}'
			set firewall.@rule[-1].src='lan'
			set firewall.@rule[-1].dest_ip='${ip}'
			set firewall.@rule[-1].proto='tcp udp'
			set firewall.@rule[-1].dest_port='80 443 8080 8443'
			set firewall.@rule[-1].target='REJECT'
EOF
	}
	guest_ip=$(uci -q get network.guest.ipaddr 2>/dev/null)
	[ -z "$guest_ip" ] && guest_ip=192.168.9.1
	iot_ip=$(uci -q get network.iot.ipaddr 2>/dev/null)
	[ -z "$iot_ip" ] && iot_ip=192.168.10.1
	_block_one guest "$guest_ip"
	_block_one iot "$iot_ip"
}

setup_lan
setup_guest
setup_iot
setup_firewall_zones
setup_block_lan_mgmt_rules

uci commit network
uci commit dhcp
uci commit firewall
uci -q commit gl-black_white_list

exit 0
