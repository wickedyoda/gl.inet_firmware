    if [ -z "`uci -q get network.secondwan.metric`"  ];then
        uci set network.secondwan.metric='15'
        uci commit network
    fi

}

uci -q get dhcp.@domain[0] && {
    uci -q get dhcp.@domain[1] || {
        uci add dhcp domain
        uci set dhcp.@[-1].name='console.gl-inet.com'
        uci set dhcp.@[-1].ip="::ffff:$(uci -q get network.lan.ipaddr)"
        uci commit dhcp
    }
}

has_radio="$(get_radio)"

if [ -z "$has_radio" ]; then
uci -q batch <<-EOF
    delete kmwan.wwan
    delete kmwan.wwan6
    commit kmwan
EOF
echo "" > /etc/config/wireless
fi

has_usb=$(get_usb)

if [ "$has_usb" == "0" ];then
    uci delete kmwan.tethering 2>/dev/null
    uci delete kmwan.tethering6 2>/dev/null
    uci commit kmwan
fi

has_secondwan && [ ! $(uci -q get kmwan.secondwan) ] && {
uci -q batch <<-EOF
    set kmwan.secondwan="member"
    set kmwan.secondwan.interface="secondwan"
    set kmwan.secondwan.addr_type="4"
    set kmwan.secondwan.track_mode="force"
    set kmwan.secondwan.metric="15"
    set kmwan.secondwan.weight="1"
    set kmwan.secondwan.disabled="0"
    set kmwan.secondwan.check="1"

    commit kmwan
EOF

