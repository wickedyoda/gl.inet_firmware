if [ "$(uci -q get network.lan.type)" == "bridge" ];then
    mac=$(cat /etc/board.json | jsonfilter -e '@.network.lan.macaddr')
    uci set network.lan.macaddr="$mac"
fi

set_br_lan_mac() {
    [ -n "$(uci -q get network.lan.device)" ] && {
        [ "$(uci -q get network.$1.name)" == "br-lan" ] && {
            mac=$(cat /etc/board.json | jsonfilter -e '@.network.lan.macaddr')
            uci set network.$1.macaddr="$mac"
        }
    }
}

config_load network
config_foreach  set_br_lan_mac device
uci commit network
