. /lib/functions.sh
. /lib/functions/gl_util.sh

fix_ath79_upgrade_noip()
{
    local node="/sys/devices/platform/ahb/1a000000.eth/1a000000.eth:mdio/mdio_bus/mdio.0/mdio.0:1f/of_node/compatible"
    [ -e "$node" ] && {
        local compatible="$(cat $node)"
        [ "$compatible" = "qca,ar8229-builtin" ] && {
            swconfig dev switch0 set reset
        }
    }
}

setting_rg650v_platform_vendor_netwotk()
{
    #Assign Auto-IP to RNDIS interface
    uci set network.rndis="interface"
    uci set network.rndis.device="rndis0"
    uci set network.rndis.proto="static"
    uci set network.rndis.ipaddr="169.254.20.1"
    uci set network.rndis.ipv6="1"
    uci set network.rndis.netmask="255.255.255.0"

    #Assign Auto-IP to ECM interface
    uci set network.ecm="interface"
    uci set network.ecm.device="ecm0"
    uci set network.ecm.proto="static"
    uci set network.ecm.ipaddr="169.254.21.1"
    uci set network.ecm.ipv6="1"
    uci set network.ecm.netmask="255.255.255.0"
    #Assign Auto-IP to ETH interface
    uci set network.eth="interface"
    uci set network.eth.device="eth0"
    uci set network.eth.mtu="1500"
    uci set network.eth.proto="static"
    uci set network.eth.ipaddr="169.254.22.1"
    uci set network.eth.ipv6="1"
    uci set network.eth.netmask="255.255.255.0"

    uci set network.wlan0=interface
    uci set network.wlan0.device='wlan0'
    uci set network.wlan0.proto='static'
    uci set network.wlan0.ipv6='1'
    uci set network.wlan0.ipaddr='169.254.24.1'
    uci set network.wlan0.netmask='255.255.255.0'

    uci set network.wlan1=interface
    uci set network.wlan1.device='wlan1'
    uci set network.wlan1.proto='static'
    uci set network.wlan1.ipv6='1'
    uci set network.wlan1.ipaddr='169.254.25.1'
    uci set network.wlan1.netmask='255.255.255.0'

    uci set network.wlan2=interface
    uci set network.wlan2.device='wlan2'
    uci set network.wlan2.proto='static'
    uci set network.wlan2.ipv6='1'
    uci set network.wlan2.ipaddr='169.254.26.1'
    uci set network.wlan2.netmask='255.255.255.0'

    # store lan ipaddr and netmask, required this for IPPT clean up
    uci add qcmap_lan lan
    uci set qcmap_lan.@lan[0].ip="192.168.8.1"
    uci set qcmap_lan.@lan[0].netmask="255.255.255.0"
    uci commit
}

init_secondwan_by_default()
{
    [ -r /proc/gl-hw-info/secondwan ] || return
    read -r sw_dev < /proc/gl-hw-info/secondwan || return
    [ -z "$sw_dev" ] && return

    sw_base="${sw_dev%.*}"
    sw_vlan="${sw_dev##*.}"

    dev_sid=""
    for sid in $(uci -q show network 2>/dev/null | sed -n "s/^network\.\([^=]*\)=device\$/\1/p"); do
        [ "$(uci -q get "network.${sid}.name" 2>/dev/null)" = "$sw_dev" ] && {
            dev_sid="$sid"
            break
        }
    done

    if [ -n "$dev_sid" ]; then
        [ "$dev_sid" != "secondwan_dev" ] && uci -q rename "network.${dev_sid}=secondwan_dev" && uci commit network
    else
        mac=$(cat /etc/board.json | jsonfilter -e '@.network.lan.macaddr')
        mac=$(printf '%s:%02x' "${mac%:*}" $(( (0x${mac##*:} + 1) & 0xff )))
        uci -q batch <<-EOF
            set network.secondwan_dev="device"
            set network.secondwan_dev.name="$sw_dev"
            set network.secondwan_dev.ifname="$sw_base"
            set network.secondwan.device="$sw_dev"
            set network.secondwan_dev.macaddr="$mac"
            commit network
EOF
    fi
    uci set glconfig.general.lan2wan="1"
    uci commit glconfig
    uci set board_special.hardware.secondwan="$sw_dev"
    uci commit board_special

    vlan2_sid="$(uci -q show network | awk -F"[.=']" -v v="$sw_vlan" '
        $1=="network" && $3=="switch_vlan" { sw[$2]=1; next }
        $1=="network" && $3=="vlan" && ($4==v || $5==v) { if (sw[$2]) { print $2; exit } }
    ')"
    [ -n "$vlan2_sid" ] && [ "$vlan2_sid" != "vlan_secondwan" ] && {
        uci -q rename network.${vlan2_sid}=vlan_secondwan
        uci commit network
    }
}

fix_ipq40xx_wan_vlan
fix_ath79_upgrade_noip
set_br_lan_bridge_empty

sed -i "/multicast_to_unicast '0'/d" /etc/config/network

[ -z "`uci -q get network.wan.force_link`" ] && uci set network.wan.force_link='0' && uci commit network

