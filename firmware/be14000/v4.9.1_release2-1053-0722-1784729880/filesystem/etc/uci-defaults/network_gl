    do
        uci add_list kmwan.secondwan.tracks="ping,$track_ip"
    done

    uci commit kmwan
}

has_secondwan && [ ! $(uci -q get kmwan.secondwan6) ] && {
uci -q batch <<-EOF
    set kmwan.secondwan6="member"
    set kmwan.secondwan6.interface="secondwan6"
    set kmwan.secondwan6.addr_type="6"
    set kmwan.secondwan6.track_mode="force"
    set kmwan.secondwan6.metric="15"
    set kmwan.secondwan6.weight="1"
    set kmwan.secondwan6.disabled="1"

    commit kmwan
EOF

    for track_ip in `uci -q get glconfig.general.track_ipv6`
    do
        uci add_list kmwan.secondwan6.tracks="ping,$track_ip"
    done

    uci commit kmwan
}

[ "$(uci -q get glconfig.general.inited)" = "1" ] && exit 0

uci -q batch <<-EOF
    set network.lan.isolate=0
    set network.lan.ipaddr='192.168.8.1'
    commit network
EOF

model="$(get_model)"
[ "$model" = "e5800" ] && {
    setting_rg650v_platform_vendor_netwotk
}

uci -q batch <<-EOF
    delete network.wan6.device
    set network.wan.ipv6='0'
    set network.wan6.device='@wan'
    set network.wan6.disabled='1'
    set network.tethering6='interface'
    set network.tethering6.device='@tethering'
    set network.tethering6.proto='dhcpv6'
    set network.tethering6.disabled='1'
    set network.wwan6='interface'
    set network.wwan6.device='@wwan'
    set network.wwan6.proto='dhcpv6'
    set network.wwan6.disabled='1'
    commit network
EOF

openwrt_version=$(ubus call system board | jsonfilter -e '@.release.description' | grep -o '[0-9]\+' | head -n 1)

[ "$openwrt_version" -lt 21 ] && {
   uci -q batch <<-EOF
    delete network.wan6.device
    delete network.tethering6.device
    delete network.wwan6.device
    set network.wan6.ifname='@wan'
    set network.tethering6.ifname='@tethering'
    set network.wwan6.ifname='@wwan'
    commit network
EOF
}

uci -q batch <<-EOF
    set dhcp.@dnsmasq[0].rebind_protection=0

    add dhcp domain
    set dhcp.@[-1].name='console.gl-inet.com'
    set dhcp.@[-1].ip="$(uci -q get network.lan.ipaddr)"
    add dhcp domain
    set dhcp.@[-1].name='console.gl-inet.com'
    set dhcp.@[-1].ip="::ffff:$(uci -q get network.lan.ipaddr)"
    commit dhcp
EOF

uci -q batch <<-EOF
    set firewall.@zone[1].input=DROP
    add_list firewall.@zone[1].network=wwan
    commit firewall
EOF

is_otg=$(is_usb_otg)
[ "$is_otg" = "1" ] && {
uci -q batch <<-EOF
    add_list network.@device[0].ports='rndis0'
    add_list network.@device[0].ports='ecm0'

    set network.usbwan="interface"
    set network.usbwan.force_link="0"
    set network.usbwan.ipv6="0"
    set network.usbwan.proto="dhcp"

    set network.usbwan6="interface"
    set network.usbwan6.proto="dhcpv6"
    set network.usbwan6.device="@usbwan"
    set network.usbwan6.disabled="1"
    commit network

    set dhcp.usbwan="dhcp"
    set dhcp.usbwan.interface="usbwan"
    set dhcp.usbwan.ignore="1"
    commit dhcp

    add_list firewall.@zone[1].network="usbwan"
    commit firewall
EOF
}

[ -n "$has_radio" ] && {
uci -q batch <<-EOF
    set network.wwan=interface
    set network.wwan.proto='dhcp'
    commit network
EOF
} 

has_secondwan && {
uci -q batch <<-EOF
    set network.secondwan="interface"
    set network.secondwan.ipv6="0"
    set network.secondwan.proto="dhcp"
    set network.secondwan.metric="15"
    set network.secondwan.force_link="0"

    set network.secondwan6="interface"
    set network.secondwan6.proto="dhcpv6"
    set network.secondwan6.device="@secondwan"
    set network.secondwan6.disabled="1"
    commit network

    set dhcp.secondwan="dhcp"
    set dhcp.secondwan.interface="secondwan"
    set dhcp.secondwan.ignore="1"
    commit dhcp

    add_list firewall.@zone[1].network="secondwan"
    commit firewall
EOF

[ "$model" = "be14000" ] && init_secondwan_by_default

[ "$openwrt_version" -lt 21 ] && {
uci -q batch <<-EOF
    delete network.secondwan6.device
    set network.secondwan6.ifname="@secondwan"
    commit network
EOF
}
}

