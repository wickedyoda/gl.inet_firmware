#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034
# shellcheck disable=SC3043
USE_PROCD=1

START=99

. /lib/functions/gl_util.sh
model=$(get_model)

mount_filter_img() {
    size=$1
    count=$2

    if [ -z "$size" ] || [ -z "$count" ]; then
        return 1
    fi

    if [ ! -f /etc/AdGuardHome/data.img ]; then
        rm -rf a/etc/AdGuardHome/data/filters
        #Create mount directory
        mkdir -p /etc/AdGuardHome/data/filters/

        #Create an image file (the exact size depends on the number of supported entries tested).
        dd if=/dev/zero of=/etc/AdGuardHome/data.img bs=$size count=$count
        #Format the image as ext4.
        mkfs.ext4 -F -q /etc/AdGuardHome/data.img
    fi

    if [ -f /etc/AdGuardHome/data.img ] && ! grep -q /etc/AdGuardHome/data/filters /proc/mounts; then
        #Mount the image to the blacklist/whitelist storage directory of adguardhome
        mount -o loop /etc/AdGuardHome/data.img /etc/AdGuardHome/data/filters/ > /dev/null 2>&1
    fi

    return 0
}

start_service() {
    [ "$(uci -q get adguardhome.config.enabled)" = "1" ] || exit 0

    mkdir -p /etc/AdGuardHome

    #b1300 dose not support mmap,need link the data to tmp fs
    [ "$model" = "b1300" ] && {
        rm -rf /etc/AdGuardHome/data 2>/dev/null
        mkdir -p /tmp/AGH_data
        ln -s /tmp/AGH_data /etc/AdGuardHome/data
    }

    case "$model" in
        "mt3600be")
            mount_filter_img 5M 2
            ;;
    esac

    /etc/init.d/firewall reload

    procd_open_instance
    procd_set_param respawn
    procd_set_param group explict_vpn
    procd_set_param stderr 1
    procd_set_param command /usr/bin/AdGuardHome --glinet --no-check-update -c /etc/AdGuardHome/config.yaml -w /etc/AdGuardHome -l syslog
    # Go 1.24+: net.ListenConfig defaults to MPTCP on Linux; disable for this process only.
    GODEBUG="${GODEBUG:+$GODEBUG,}multipathtcp=0"
    procd_set_param env GODEBUG="$GODEBUG"
    procd_close_instance
}

stop_service(){
    /etc/init.d/firewall reload
}
