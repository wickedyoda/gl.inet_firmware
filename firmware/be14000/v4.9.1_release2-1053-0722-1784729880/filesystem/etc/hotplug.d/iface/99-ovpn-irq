mt7981_ovpn_irq() {
        [ $ACTION = "ifup" ] || return
        [ `echo "${INTERFACE}" | grep ovpn|wc -l` -ge 1 ] || [ "$INTERFACE" = "wan" -o "$INTERFACE" = "lan" ] || return
        if ls /sys/class/net/ovpnclient* >/dev/null 2>&1; then
                [ -e /sys/class/net/eth0 ] && echo 3 > /sys/class/net/eth0/queues/rx-0/rps_cpus
                [ -e /sys/class/net/eth1 ] && echo 0 > /sys/class/net/eth1/queues/rx-0/rps_cpus
                [ -e /sys/class/net/br-lan ] && echo 0 > /sys/class/net/br-lan/queues/rx-0/rps_cpus

                for iface in /sys/class/net/ovpnclient*; do
                        if [ -e "$iface" ]; then
                                echo 3 > "$iface/queues/rx-0/rps_cpus"
                        fi
                done
                #ovpn_irq_smp_affinity "15100000.ethernet" "2 2 2"
        fi
}

model=$(get_model)
case "$model" in
	"be9300"|\
	"be6500"|\
	"be3600")
		ipq53xx_ovpn_irq
	;;
	"be10000"|\
	"mt3600be"|\
	"be14000")
		mt3600be_ovpn_irq
	;;
	"mt5000")
		mt5000_ovpn_irq
	;;
	"x3000"|\
	"xe3000")
		mt7981_ovpn_irq
	;;
esac
