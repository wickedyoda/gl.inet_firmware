get_wan_device() {
    local wan="$1"
    local device
    device=$(uci -q get network."$wan".device)
    if [ -n "$device" ] && [ -n "$(echo "$device" | grep -E 'eth|lan')" ]; then
        echo "$device"
        return
    fi
    device=$(uci -q get network."$wan".ifname)
    if [ -n "$device" ] && [ -n "$(echo "$device" | grep -E 'eth|lan')" ]; then
        echo "$device"
        return
    fi
}

set_accept_ra_for_wan() {
    device=$(get_wan_device "$INTERFACE")
    proto=$(uci -q get network.$INTERFACE.proto)

    [ -n "$device" ] && [ "$proto" = "pppoe" ] && {
        ip -6 route | while IFS= read -r route; do
            if echo "$route" | grep -q "dev $device "; then
                tmp_route=$(echo "$route" | sed 's/\(.*\)\smetric.*/\1/')
                ip -6 route delete $tmp_route 2>/dev/null
            fi
        done

        [ -f "/proc/sys/net/ipv6/conf/$device/accept_ra" ] && [ "$(cat /proc/sys/net/ipv6/conf/$device/accept_ra)" != "0" ] && {
            echo 0 > /proc/sys/net/ipv6/conf/$device/accept_ra
        }
        sed -i '/net.ipv6.conf.$device.accept_ra=2/d' /etc/sysctl.d/99-disable-ipv6.conf 2>/dev/null
        return
    }

    [ -n "$device" ] && [ "$proto" != "pppoe" ] && { 
        echo "/proc/sys/net/ipv6/conf/$device/accept_ra is not equal to 1"
        [ -f "/proc/sys/net/ipv6/conf/$device/accept_ra" ] && [ "$(cat /proc/sys/net/ipv6/conf/$device/accept_ra)" != "2" ] && {
            echo 2 > /proc/sys/net/ipv6/conf/$device/accept_ra
        }
        [ "$(cat /etc/sysctl.d/99-disable-ipv6.conf | grep "net.ipv6.conf.$device.accept_ra=2")" = "" ] && echo net.ipv6.conf.$device.accept_ra=2 >> /etc/sysctl.d/99-disable-ipv6.conf
    }
}

ipv6_enabled=$(uci -q get glipv6.globals.enabled)
[ "$INTERFACE" = "wan" ] || [ "$INTERFACE" = "secondwan" ] && [ "$ipv6_enabled" = "1" ] && set_accept_ra_for_wan

[ -n "$(echo "$INTERFACE" | grep -e ^ovpn -e ^wg)" ] && exit 0

status=$(ubus call gl-session call '{"module":"cable", "func":"get_status"}' | jsonfilter -e '@.result')
ubus call gl-session notify "{\"name\": \"cable.status\", \"data\":$status}"
