#!/bin/sh

init_tethering_force()
{
    iptables -t mangle -N TETHERING_TTL 2>/dev/null
    iptables -t mangle -C POSTROUTING -j TETHERING_TTL
    [ ! "$?" = "0" ] && iptables -t mangle -I POSTROUTING -j TETHERING_TTL
    iptables -t mangle -F TETHERING_TTL

    ip6tables -t mangle -N TETHERING_TTL 2>/dev/null
    ip6tables -t mangle -C POSTROUTING -j TETHERING_TTL
    [ ! "$?" = "0" ] && ip6tables -t mangle -I POSTROUTING -j TETHERING_TTL
    ip6tables -t mangle -F TETHERING_TTL
}

force_tethering_ttl()
{
    dev=$(uci get network.tethering.ifname)
    ttl=$(uci get network.tethering.ttl)
    [ "$ttl" != "" ] && iptables -t mangle -A TETHERING_TTL -o $dev -j TTL --ttl-set $ttl

    ttl_ipv6=$(uci get network.tethering.ttl_ipv6)
    [ "$ttl_ipv6" != "" ] && ip6tables -t mangle -A TETHERING_TTL -o $dev -m hl ! --hl-eq 255 -j HL --hl-set $ttl_ipv6
}

if [ -n "$(uci show network | grep network.tethering.ttl)" ];then
    init_tethering_force
    force_tethering_ttl
else
    iptables -t mangle -F TETHERING_TTL
    iptables -t mangle -D POSTROUTING -j TETHERING_TTL
    iptables -t mangle -X TETHERING_TTL

    ip6tables -t mangle -F TETHERING_TTL
    ip6tables -t mangle -D POSTROUTING -j TETHERING_TTL
    ip6tables -t mangle -X TETHERING_TTL
fi
