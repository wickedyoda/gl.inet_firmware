#!/bin/sh

. /lib/functions/modem.sh

. /lib/functions/gl_log.sh

iface="$(get_modem_iface)"
iface_s1="${iface}_s1"
iface_s2="${iface}_s2"

if uci get network.$iface_s1 >/dev/null 2>&1; then
    uci delete network.$iface_s1
fi

if uci get network.$iface_s2 >/dev/null 2>&1; then
    uci delete network.$iface_s2
fi

uci commit network >/dev/null 2>&1

if [ "$(uci -q get glmodem.global.log_level)" = "1" ]; then
    uci -q set glmodem.global.log_level=0
    uci commit glmodem >/dev/null 2>&1
fi

sync
