#!/bin/sh

. /lib/functions.sh

APPEND_CONF_DIR="/etc/wireguard/profile"
mkdir -p ${APPEND_CONF_DIR}

set_server_s_append()
{
	local server_name="$1";shift
	local proto_type="$1";shift
	local origin_append_file="$1";shift

	config_load wireguard_server

	mkdir -p ${APPEND_CONF_DIR}/wgserver/

	case "${proto_type}" in
		"1")
			rm -f ${APPEND_CONF_DIR}/wgserver/${server_name}
			echo "$(grep -iE '^(jc|jmax|jmin|s1|s2|s3|s4|h1|h2|h3|h4|i1|i2|i3|i4|i5)\b' ${origin_append_file} 2>/dev/null)" >> "${APPEND_CONF_DIR}/wgserver/${server_name}"
			rm -f ${origin_append_file}
		;;
		*)
		;;
	esac

	uci set wireguard_server.${server_name}.type="${proto_type}"

    uci commit wireguard_server

	return 0
}


ret_err()
{
	echo "error!

usage:
	wgserver_set_append servername protocol config_path
eg.
	wgserver_set_append \"main_server\" \"amneziaWG\" \"/tmp/awgserver.conf\"
"

	exit 1

}

section="$1";shift
protocol="$1";shift
config_file="$1";shift
proto_type='0'

[ "$(uci -q get wireguard_server.${section})" != 'servers' ] && ret_err

case "${protocol}" in
	"amneziaWG")
		proto_type='1'
	;;
	*)
		ret_err
	;;
esac

[ -f ${config_file} ] || ret_err

set_server_s_append "$section" "$proto_type" "$config_file"

