    local group_name
    local res
    local c = uci.cursor()

    if not params.group_id or (not params.update_all and not params.peer_id) then
        return {
            err_code = err.VPN_ERR_PARAM_MISSING,
            err_msg = err.err_msg[err.VPN_ERR_PARAM_MISSING]
        }
    end

