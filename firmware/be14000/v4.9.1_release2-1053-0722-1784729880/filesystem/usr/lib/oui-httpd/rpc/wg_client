local ubus = require "oui.ubus"
local lfactory = require "lfactory"
local wg = require "gl.wg_client"
local err = require "gl.vpn_err_code"
local provider_list = wg.provider_list

local M = {}

local function is_expressvpn_partner_device()
    local helper = "/etc/wireguard/scripts/get_partner.sh"
    if not fs.access(helper) then
        return false
    end

    local handle = io.popen(". " .. helper .. "; get_partner 2>/dev/null")
    if not handle then
        return false
    end

    local partner = handle:read("*l") or ""
    handle:close()

    return partner == "expressvpn"
end

local function is_hidden_expressvpn_partner_provider(c, group)
    if not is_expressvpn_partner_device() then
        return false
    end

    local group_name = c:get("wireguard", group, "group_name")
    local group_type = tonumber(c:get("wireguard", group, "group_type") or "")

    return group_type == 1 and group_name ~= "ExpressVPN" and group_name ~= "FromApp"
end

local function hidden_provider_error()
    return {
        err_code = err.VPN_ERR_UNKNOWN_PROVIDER,
        err_msg = err.err_msg[err.VPN_ERR_UNKNOWN_PROVIDER]
    }
end

