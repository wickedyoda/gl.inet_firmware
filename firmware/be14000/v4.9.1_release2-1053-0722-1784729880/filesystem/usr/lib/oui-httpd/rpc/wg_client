            err_msg = err.err_msg[err.VPN_ERR_PARAM_MISSING]
        }
    end

    local group = "group_"..params.group_id

    if is_hidden_expressvpn_partner_provider(c, group) then
        return hidden_provider_error()
    end

    group_name = c:get("wireguard", group, "group_name")

    if not group_name then
        return {
            err_code = err.VPN_ERR_UNKNOWN_PROVIDER,
            err_msg = err.err_msg[err.VPN_ERR_UNKNOWN_PROVIDER]
        }
    end

    if group_name ~= "ExpressVPN" then
        if not params.username then
            return {
                err_code = err.VPN_ERR_PARAM_MISSING,
                err_msg = err.err_msg[err.VPN_ERR_PARAM_MISSING]
            }
        end
    end

    if provider_list[group_name] and provider_list[group_name].get_server then
        res = provider_list[group_name].get_server(params)
    end

    return res
end

--[[
    @method-type: call
    @method-name: submit_provider_otp
    @method-desc: Submit OTP for provider MFA challenge

    @in  number  group_id     Group id of third part provider
    @in  string  username     Username
    @in  string  password     Password
    @in  string  otp          One-time password

    @out number ?err_code     Error code [20001011: "parameter missing"; 20001012:"invalid parameter"; 20001101:"unknown provider"; 20001224:"invalid two factor authentication code"]
    @out string ?err_msg      Error data

    @in-example: {"jsonrpc":"2.0","method":"call","params":["","wg_client","submit_provider_otp",{"group_id":4408, "username":"test", "password":"123456", "otp":"123456"}],"id":1}
    @out-example: {"id":1,"jsonrpc":"2.0","result":{}}
--]]
M.submit_provider_otp = function(params)
    -- gl-validator does not enforce missing numeric params, so group_id stays validated here.
    if not params.group_id or not params.username or params.username == "" or
        not params.password or params.password == "" or
        not params.otp or params.otp == "" then
        return {
            err_code = err.VPN_ERR_PARAM_MISSING,
            err_msg = err.err_msg[err.VPN_ERR_PARAM_MISSING]
        }
    end

    return wg.submit_provider_otp(params)
end

--[[
    @method-type: call
    @method-name: generate_provider_config
    @method-desc: Generate selected server's config

    @in number  group_id                      Group id
    @in array   server_info                   Server list
    @in bool    match_all                     Whether to generate all the configurations for the selected city
    @in string  ?server_info.country_id       Country id
    @in string  ?server_info.country_code     Country code
    @in string  server_info.country_name      Country name
    @in array   server_info.cities            City list
    @in string  ?server_info.cities.city_id   City id
    @in string  server_info.cities.city_name  City name
    @in array   ?server_info.cities.hostname  Server list

    @out number ?err_code     Error code [20001011: "parameter missing"; 20001012: "invalid parameter"; 20001101:"unknown provider"]
    @out string ?err_msg      Error data

    @in-example: {"jsonrpc":"2.0","method":"call","params":["","wg_client","generate_provider_config",{"group_id":2182,"match_all":false,"server_info":[{"cities":[{"city_id":"ca_vancouver","city_name":"CA Vancouver","hostname":["vancouver431"]},{"city_id":"ca_ontario-so","city_name":"CA Ontario Streaming Optimized","hostname":["ontario416"]},{"city_id":"ca_ontario","city_name":"CA Ontario","hostname":["ontario437"]}],"country_name":"CA"}]}],"id":1}
    @out-example: {"id":1,"jsonrpc":"2.0","result":[]}
--]]
M.generate_provider_config = function(params)
    local group_name
    local res
    local c = uci.cursor()

    if not params.group_id or not params.server_info or type(params.server_info) ~= "table" then
        return {
            err_code = err.VPN_ERR_PARAM_MISSING,
            err_msg = err.err_msg[err.VPN_ERR_PARAM_MISSING]
        }
    end

    local group = "group_"..params.group_id

    if is_hidden_expressvpn_partner_provider(c, group) then
        return hidden_provider_error()
    end

    group_name = c:get("wireguard", group, "group_name")

    if not group_name then
        return {
            err_code = err.VPN_ERR_UNKNOWN_PROVIDER,
            err_msg = err.err_msg[err.VPN_ERR_UNKNOWN_PROVIDER]
        }
    end

    if group_name == "IPVanish" and not params.match_all then
        wg.clean_unselect_peers(params.group_id, params.server_info)
    elseif group_name == "ExpressVPN" and not params.match_all then
        wg.clean_unselect_peers(params.group_id, params.server_info)
    else
        wg.clean_old_peers(params.group_id)
    end

    if provider_list[group_name] and provider_list[group_name].gen_config then
        res = provider_list[group_name].gen_config(params)
    else
        return {
            err_code = err.VPN_ERR_PARAM_INVALIED,
            err_msg = err.err_msg[err.VPN_ERR_PARAM_INVALIED]
        }
    end

    ubus.call('gl-session', 'call', {
        module = "vpn-client",
        func = "check_vpn_config",
        params = {}
    })

    return res
end

