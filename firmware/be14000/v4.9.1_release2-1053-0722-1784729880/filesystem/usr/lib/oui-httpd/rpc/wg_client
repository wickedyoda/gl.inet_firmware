--[[
    @method-type: call
    @method-name: get_max_client
    @method-desc: Calculate how many client configurations the available memory can be used to save

    @out  number   max_client      The max clients can be set[0: not memory available]
    @in-example: {"jsonrpc":"2.0","method":"call","params":["","wg_client","get_max_client",{}],"id":1}
    @out-example: {"id":1,"jsonrpc":"2.0","result":{"max_client":435110}}
--]]
M.get_max_client = function(params)
    local res
    local memory_available
    local memory_total
    local max_count

    local system_status = ubus.call("system", "info")
    if type(system_status) == "table" and  type(system_status.memory) == "table" then
        memory_total = system_status.memory.total
        memory_available = system_status.memory.available or (system_status.memory.free + system_status.memory.buffered)
    end

    local _, flash_available = fs.statvfs("/")
    local flash_total = 0
    if fs.access("/proc/gl-hw-info/flash_size") then
        flash_total = string.gsub(lfactory.get_falsh_size(), "[^%d]", "") * 1024 * 1024
    end

    memory_available = memory_available - (memory_total * 0.05)
    flash_available = flash_available - (flash_total * 0.05)

    if flash_available < memory_available then
        max_count = flash_available / 700
    else
        max_count = memory_available / 700
    end

    -- if available memory is too small, limit again
    if max_count < 500 then
        max_count = max_count / 2
    end

    res = {
        max_client = math.max(math.floor(max_count), 0)
    }

    return res
end

