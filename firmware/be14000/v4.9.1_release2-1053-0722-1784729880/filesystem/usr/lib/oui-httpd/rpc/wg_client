--[[
    @method-type: call
    @method-name: start_random_client
    @method-desc: Start random client of the selected group

    @in  number  group_id     Group id of third part provider
    @in  number  ?peer_id     Peer id of third part provider
    @in  number  ?peer_count  Peer count of selected group

    @out number ?err_code     Error code [20001011: "parameter missing"; 20001213: "vpn client failed to connect to server"]
    @out string ?err_msg      Error data

    @in-example: {"jsonrpc":"2.0","method":"call","params":["","wg_client","start_random_client",{"group_id":676, "peer_id":654}],"id":1}
    @out-example: {"id":1,"jsonrpc":"2.0","result":[]}
--]]
M.start_random_client = function(params)
    local res = {}
    local timeout = 60
    local c = uci.cursor()

    if not params.group_id then
        return {
            err_code = err.VPN_ERR_PARAM_MISSING,
            err_msg = err.err_msg[err.VPN_ERR_PARAM_MISSING]
        }
    end

    local group = "group_"..params.group_id
    if is_hidden_expressvpn_partner_provider(c, group) then
        return hidden_provider_error()
    end

    os.execute(string.format("killall -9 /etc/wireguard/scripts/start_random_client.sh 2 >/dev/null"))

    if params.peer_count then
        timeout = 30 * params.peer_count + 10
    end

    local cmd
    if not params.peer_id then
        cmd = string.format("timeout %d /etc/wireguard/scripts/start_random_client.sh %d", timeout, params.group_id)
    else
        cmd = string.format("timeout %d /etc/wireguard/scripts/start_random_client.sh %d %d", timeout, params.group_id, params.peer_id)
    end

    local handle = ngx.pipe.spawn(cmd, { stdout_read_timeout = timeout * 1000 })
    local output = handle:stdout_read_all()

    if output and string.find(output, "connect failed") then
        res = {
            err_code = err.VPN_ERR_VPN_CLIENT_CONNECT_FAIL,
            err_msg = err.err_msg[err.VPN_ERR_VPN_CLIENT_CONNECT_FAIL]
        }
    end

    return res
end

